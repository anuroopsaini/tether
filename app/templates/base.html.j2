<!doctype html><html><head><meta charset="utf-8"><style>
@page { size: Letter; margin: 18mm; } body { font-family: Arial, sans-serif; color:#172033; font-size:11px; line-height:1.45 } h1{font-size:28px;margin:0;color:#18244a} h2{font-size:16px;margin:24px 0 8px}.muted{color:#667085}.summary{background:#f3f5fb;padding:14px;border-radius:10px;margin:16px 0}.claim{border-left:5px solid #1d9b63;padding:12px 14px;margin:12px 0;background:#fafbff}.yellow{border-color:#e5a600}.red{border-color:#d84a4a}.purple{border-color:#8e58c7}.label{font-size:10px;text-transform:uppercase;font-weight:bold;color:#667085}.excerpt{background:#eef1f7;padding:9px;margin-top:8px;font-style:italic}.footer{margin-top:30px;padding-top:10px;border-top:1px solid #ddd;color:#667085;font-size:9px}</style></head><body>{% block content %}{% endblock %}</body></html>
