{% extends "base.html.j2" %}{% block content %}
<h1>Tether Supporting Appendix</h1><p class="muted">{{ analysis.doc_type | replace('_', ' ') | title }} · Generated {{ analysis.created_at.strftime('%B %d, %Y') }}</p>
<div class="summary"><strong>{{ analysis.result.summary.evidence_backed }} of {{ analysis.result.summary.claims_reviewed }} claims are supported by the supplied material</strong><br>{{ analysis.result.summary.needing_changes }} claims need stronger support · {{ analysis.result.summary.privacy_flags }} privacy flags</div>
<h2>Claims matched to student-provided sources</h2>
{% for claim in analysis.result.claims %}{% if claim.color in ['green', 'yellow'] %}<section class="claim {{ claim.color }}"><div class="label">{{ claim.action }}</div><strong>Original claim:</strong> {{ claim.text }}<br><strong>Suggested wording:</strong> {{ claim.accepted_rewrite or claim.safe_rewrite }}<p>{{ claim.evidence_match }}</p>{% for snippet in claim.evidence_snippets %}<div class="excerpt">“{{ snippet.text }}”<br><span class="muted">Student-provided source: {{ snippet.file_name }}{% if snippet.page %}, page {{ snippet.page }}{% endif %}</span></div>{% endfor %}{% if claim.provenance_note %}<p class="muted">Provenance: {{ claim.provenance_note }}</p>{% endif %}</section>{% endif %}{% endfor %}
{% if include_notes %}<h2>Improvement notes</h2>{% for claim in analysis.result.claims %}{% if claim.color in ['red','purple'] %}<section class="claim {{ claim.color }}"><strong>{{ claim.text }}</strong><p>{{ claim.risk }}</p><strong>Suggested rewrite:</strong> {{ claim.safe_rewrite }}{% if claim.missing_proof %}<p class="muted">Missing proof: {{ claim.missing_proof | join(', ') }}</p>{% endif %}</section>{% endif %}{% endfor %}{% endif %}
<p class="footer">Claims matched against student-provided evidence. Authenticity not independently verified. This appendix is optional and should be attached only when permitted by the receiving program.</p>{% endblock %}
