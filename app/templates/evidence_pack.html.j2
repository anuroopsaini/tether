{% extends "base.html.j2" %}{% block content %}
<h1>Tether Evidence Pack</h1><p class="muted">{{ analysis.doc_type | replace('_', ' ') | title }} · Generated {{ analysis.created_at.strftime('%B %d, %Y') }}</p>
<div class="summary"><strong>Credibility summary: {{ analysis.result.summary.trust_score }}/100</strong><br>{{ analysis.result.summary.evidence_backed }} evidence-backed claims · {{ analysis.result.summary.needing_changes }} claims needing changes · {{ analysis.result.summary.privacy_flags }} privacy flags</div>
<h2>Evidence-backed claims</h2>
{% for claim in analysis.result.claims %}{% if claim.color in ['green', 'yellow'] %}<section class="claim {{ claim.color }}"><div class="label">{{ claim.color }} · {{ claim.action }}</div><strong>Original claim:</strong> {{ claim.text }}<br><strong>Recommended wording:</strong> {{ claim.accepted_rewrite or claim.safe_rewrite }}<p>{{ claim.evidence_match }}</p>{% for snippet in claim.evidence_snippets %}<div class="excerpt">“{{ snippet.text }}”<br><span class="muted">{{ snippet.file_name }}{% if snippet.page %}, page {{ snippet.page }}{% endif %}</span></div>{% endfor %}{% if claim.provenance_note %}<p class="muted">Provenance: {{ claim.provenance_note }}</p>{% endif %}</section>{% endif %}{% endfor %}
{% if include_notes %}<h2>Improvement notes</h2>{% for claim in analysis.result.claims %}{% if claim.color in ['red','purple'] %}<section class="claim {{ claim.color }}"><strong>{{ claim.text }}</strong><p>{{ claim.risk }}</p><strong>Suggested rewrite:</strong> {{ claim.safe_rewrite }}{% if claim.missing_proof %}<p class="muted">Missing proof: {{ claim.missing_proof | join(', ') }}</p>{% endif %}</section>{% endif %}{% endfor %}{% endif %}
<p class="footer">Generated by Tether — evidence reviewed for claim-to-source alignment.</p>{% endblock %}
